			local started = false
			pcall(function()
				local st = findRemote("StartAutoDrive", "RemoteFunction")
				if st then started = st:InvokeServer(carName, carId) end
			end)
			if not started then
				notify("Auto Farm: server refused (locked or already driving?)")
				Flags.AutoDrive = false
				Flags._driveRunning = false
				return
