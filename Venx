MiscTab:AddToggle({
	Title = "Auto Speed Traps",
	Subtitle = "Sit in a vehicle first",
	Icon = "camera",
	Default = false,
	Callback = function(state)
		Fresh.Traps = state
		freshLog("Speed Traps " .. (state and "enabled" or "disabled"))
		if not state or Fresh._trapsRunning then return end
		local folder = workspace:FindFirstChild("SpeedCameras")
		if not folder then
			pcall(function()
				local a = ReplicatedStorage:FindFirstChild("Assets")
				local w = a and a:FindFirstChild("Waypoints")
				folder = w and w:FindFirstChild("SpeedTrapWaypoints")
			end)
		end
		if not folder then
			freshNotify("No speed cameras found")
			Fresh.Traps = false
			return
		end
		Fresh._trapsRunning = true
		task.spawn(function()
			while Fresh.Traps and not FreshOff do
				local live = workspace:FindFirstChild("SpeedCameras") or folder
				if not live then
					freshStatus("Status: Traps - folder gone")
					task.wait(2)
				else
					local cams = {}
					pcall(function()
						for _, d in ipairs(live:GetDescendants()) do
							if d:IsA("BasePart") then cams[#cams + 1] = d end
						end
					end)
					local me = freshHrpPos()
					if me and #cams > 1 then
						local dist = {}
						for _, o in ipairs(cams) do
							local okD, p = pcall(function() return (o.Position - me).Magnitude end)
							dist[o] = (okD and p) or math.huge
						end
						pcall(function()
							table.sort(cams, function(a, b)
								return (dist[a] or math.huge) < (dist[b] or math.huge)
							end)
						end)
					end
					for i, cam in ipairs(cams) do
						if not Fresh.Traps or FreshOff then break end
						local okC, cpos = pcall(function() return cam.Position end)
						if okC and cpos then
							freshStatus(string.format("Status: Trap %d/%d [%s]", i, #cams, TrapMode))
							if TrapMode == "Teleport" then
								freshGoto(cam.CFrame + Vector3.new(0, 3, 0))
								freshPromptBurst(cpos, 16)
								freshTouch(cam)
							else
								local seat = freshSeat()
								if seat and seat:IsA("VehicleSeat") then
									pcall(function() seat.MaxSpeed = CruiseSpeed end)
									freshSteerTo(cpos + Vector3.new(0, 3, 0), CruiseSpeed, 20, "Traps", 25)
								else
									freshGoto(cam.CFrame + Vector3.new(0, 3, 0))
									freshPromptBurst(cpos, 16)
									freshTouch(cam)
								end
							end
							task.wait(0.5)
						end
					end
					task.wait(0.5)
				end
			end
			Fresh._trapsRunning = false
		end)
	end,
})

