local function buildConfig(name)
	local cfg = Window.ConfigManager:CreateConfig(name)
	cfg:RegisterElement("AutoDriveSpeed", autoDriveBox)
	cfg:RegisterElement("StarAmount", starBox)
	cfg:RegisterElement("MinReward", minBox)
	cfg:RegisterElement("MaxReward", maxBox)
	cfg:RegisterElement("RaceSpeed", raceSpeedBox)
	cfg:RegisterElement("ConfigName", configName)
	cfg:RegisterElement("UIKeybind", uiKeybind)
	return cfg
end

