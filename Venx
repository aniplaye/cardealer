				local okC, kids = pcall(function() return folder:GetChildren() end)
				if okC then
					for _, r in ipairs(kids) do
						local okD, nd = pcall(function() return #r:GetDescendants() end)
						local cps = collectRaceParts(r)
						table.insert(lines, string.format("  RACE %s descs=%s points=%d", r.Name, okD and tostring(nd) or "?", #cps))
						for i = 1, math.min(8, #cps) do
							table.insert(lines, "    - " .. cps[i]:GetFullName())
						end
					end
				end
			end
			local blob = table.concat(lines, "\n")
			pcall(function() console:Write(blob) end)
			pcall(function() writefile("venas_race_diag.txt", blob) end)
			notify("Race diag saved (console + venas_race_diag.txt)")
		end)
	end,
})

-- Physics drive: face the target in place, then throttle through it.
-- No position teleports here, so teleport-guarded games still progress.
local function driveSteerTo(targetPos, speed, timeoutS, flagKey, arriveR)
	timeoutS = timeoutS or 14
	arriveR = arriveR or 16
	local t0 = os.clock()
	local lastDist, lastT, hops = nil, os.clock(), 0
	while Flags[flagKey] and not Unloaded and (os.clock() - t0) < timeoutS do
		local seat = seatOf()
		if not seat or not seat:IsA("VehicleSeat") then return false end
		local vehicle = findVehicleOf(seat)
		if not vehicle then return false end
		local okP, pivot = pcall(function() return vehicle:GetPivot() end)
		if not okP or not pivot then task.wait(0.3) continue end
		local pos = pivot.Position
		local to = targetPos - pos
		to = Vector3.new(to.X, 0, to.Z)
		local dist = to.Magnitude
		if dist < arriveR then
			pcall(function()
				seat.MaxSpeed = speed
				seat.ThrottleFloat = 1
				seat.SteerFloat = 0
			end)
			task.wait(0.4)
			return true
		end
		if lastDist and (lastDist - dist) < 1 and (os.clock() - lastT) > 4 then
			-- stuck: hop up to unstick, then keep driving
			hops += 1
			lastT = os.clock()
			pcall(function() vehicle:PivotTo(pivot + Vector3.new(0, 8, 0)) end)
			if hops >= 2 then return false end
		else
			if not lastDist or (lastDist - dist) >= 1 then lastDist, lastT = dist, os.clock() end
		end
		if to.Magnitude > 0.5 then
			pcall(function() vehicle:PivotTo(CFrame.lookAt(pos, pos + to)) end)
		end
		pcall(function()
			seat.MaxSpeed = speed
			seat.ThrottleFloat = 1
			seat.SteerFloat = 0
		end)
		task.wait(0.3)
	end
	return false
end

local function raceApproach(cpPos)
	local _, _, root = parts()
	if not root then return cpPos end
	local cur = root.Position
	local dir = cpPos - cur
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 45 then return cpPos + Vector3.new(0, 4, 0) end
	return cpPos - flat.Unit * 35 + Vector3.new(0, 5, 0)
end

local function driveCheckpoints(flagKey, runningKey, mode)
	Flags[flagKey] = true
	if Flags[runningKey] then return end
	Flags[runningKey] = true
	task.spawn(function()
		clearRaceCache()
		local warnedSeat = false
		local stallN, lapN = 0, 0
		while Flags[flagKey] and not Unloaded do
			local did = false
			pcall(function()
				local folders = findRaceFolders()
				if #folders == 0 then
					pcall(function() status:Set("Status: Race - no race folders found") end)
					return
				end
				local roots = {}
				if SelectedRace and SelectedRace ~= "All" then
					local one = findRaceRootByName(SelectedRace)
					if one then table.insert(roots, one) end
				else
					for _, folder in ipairs(folders) do
						for _, r in ipairs(folder:GetChildren()) do
							table.insert(roots, r)
						end
					end
				end
				if #roots == 0 then
					pcall(function() status:Set("Status: Race - no races (use Refresh)") end)
					return
				end
				for _, root in ipairs(roots) do
					if not Flags[flagKey] or Unloaded then break end
					task.wait(0.1)
					local cps = collectRaceParts(root)
					if #cps == 0 then
						pcall(function() status:Set("Status: Race - no parts in " .. root.Name) end)
					else
						-- fire start-line prompts once per lap so the game registers us
						pcall(function()
							local first = firstPart(cps[1])
							if first then fireNearbyPrompts(first.Position, 30) end
						end)
						for i, cp in ipairs(cps) do
							if not Flags[flagKey] or Unloaded then break end
							did = true
							local seat = seatOf()
							local speed = AutoRaceSpeed * ((mode == "drift") and 1.5 or 1)
							if seat and seat:IsA("VehicleSeat") then
								pcall(function() seat.MaxSpeed = speed end)
							else
								if not warnedSeat then
									warnedSeat = true
									notify("Race: sit in a vehicle for vehicle races")
								end
							end
							local okCp, cpPos = pcall(function() return cp.Position end)
							if okCp and cpPos then
								pcall(function()
									status:Set("Status: Race " .. root.Name .. " " .. i .. "/" .. #cps .. " lap " .. (lapN + 1) .. " [" .. RaceMode .. "]")
								end)
								if RaceMode == "Teleport" then
									collectRacePoint(cp)
									task.wait(mode == "drift" and 0.5 or 0.7)
								elseif RaceMode == "Drive" then
									driveSteerTo(cpPos + Vector3.new(0, 3, 0), speed, 14, flagKey)
								else
									-- Hybrid: teleport to 35 out, face it, drive through physically
									local ap = raceApproach(cpPos)
									local facing = CFrame.lookAt(ap, Vector3.new(cpPos.X, ap.Y, cpPos.Z))
									local seatNow = seatOf()
									if seatNow then
										local v = findVehicleOf(seatNow)
										if v then pcall(function() v:PivotTo(facing) end) end
									else
										moveTo(facing)
									end
									driveSteerTo(cpPos + Vector3.new(0, 3, 0), speed, 10, flagKey)
								end
							end
						end
						lapN += 1
					end
				end
			end)
			if did then stallN = 0 else stallN += 1 end
			if stallN == 10 then
				pcall(function() status:Set("Status: Race - waiting for checkpoints...") end)
			end
			if not did then task.wait(1.5) end
		end
		local seat = seatOf()
		if seat and seat:IsA("VehicleSeat") then
			pcall(function()
				seat.ThrottleFloat = 0
				seat.SteerFloat = 0
			end)
		end
		Flags[runningKey] = false
	end)
end

