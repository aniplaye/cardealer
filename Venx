		Flags._driveRunning = true
		task.spawn(function()
			-- first owned, non-blacklisted car (PromptCarSelection order: Name, Id)
			local carName, carId
			pcall(function()
				local gc = findRemote("GetOwnedCars", "RemoteFunction")
				if gc then
					local owned = gc:InvokeServer()
					if typeof(owned) == "table" then
						for _, c in pairs(owned) do
							local okC, nm, id = pcall(function() return c.Name, c.Id end)
							if okC and nm and not AutoDriveBlacklist[nm] then
								carName, carId = nm, id
