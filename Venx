local function notify(text)
	pcall(function()
		Window:Notify({ Title = "Vena's private Bypass", Text = text, Duration = 3 })
	end)
end

local function parts()
	local char = LP.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return nil end
	return char, hum, root
end

local function seatOf()
	local char, hum = parts()
	if not hum then return nil, nil end
	local seat = hum.SeatPart
	if not seat then return nil, nil end
	return seat, char
end

local function firstPart(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	local found = obj:FindFirstChildWhichIsA("BasePart", true)
	return found
end

local function fireNearbyPrompts(pos, radius)
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("ProximityPrompt") then
			local parent = firstPart(p.Parent)
			if parent and (parent.Position - pos).Magnitude <= (radius or 12) then
				pcall(fireproximityprompt, p)
			end
		end
	end
end

local function moveTo(cf)
	local seat = seatOf()
	if seat then
		local vehicle = seat.Parent and seat.Parent.Parent
		if vehicle and vehicle:IsA("Model") then
			local ok = pcall(function() vehicle:PivotTo(cf) end)
			if ok then return true end
		end
	end
	local _, _, root = parts()
	if root then
		pcall(function() root.CFrame = cf end)
		return true
	end
	return false
end

