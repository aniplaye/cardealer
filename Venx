	Callback = function(state)
		Flags.AutoMiles = state
		report("Miles Grinder", state)
		if state and Flags.AutoTraps and trapsToggle then
			trapsToggle:Set(false)
			notify("Miles Grinder: paused Speed Traps (they need ground driving)")
		end
		if state and Flags.AutoDrive and autoFarmToggle then
			autoFarmToggle:Set(false)
			notify("Miles Grinder: paused Auto Farm")
		end
		if not state then
			farmReleaseW()
			local seat = seatOf()
			if seat and seat:IsA("VehicleSeat") then pcall(function() seat.ThrottleFloat = 0 end) end
			return
		end
		if Flags._milesRunning then return end
		Flags._milesRunning = true
		task.spawn(function()
			local s, e = buildSkyRoad()
			local cf = skyStartCF()
			if cf then moveTo(cf) end
			task.wait(0.5)
			-- Glide drive: deterministic, physics-independent. Every render step
			-- moves the car +X at AutoDriveSpeed, locked to mid-road, hovering 1
			-- stud above the top, facing +X. Nothing to get stuck on, no chassis
			-- or input dependence. The speed box is the glide pace.
			farmReleaseW() -- W-hold era over; the glide owns motion now
			notify("Sky road ready - sit in a vehicle, it glides by itself (speed box = pace)")
			pcall(function() console:Write("Sky road: " .. tostring(math.floor(s.Y)) .. " studs up, length " .. SKY.LEN) end)
			local warnedSeat = false
			local vehParts, lastVeh, hbConn = nil, nil, nil
			Flags.SkyT0, Flags.SkyTotal, Flags.SkyRampT0 = os.clock(), 0, nil
			hbConn = RunService.Heartbeat:Connect(function(dt)
				if not Flags.AutoMiles or Unloaded then return end
				pcall(function()
					if not Flags.SkyStart then return end
					local seat = seatOf()
					local vehicle = seat and findVehicleOf(seat)
					if not (seat and vehicle) then
						if not warnedSeat then
							warnedSeat = true
							notify("Miles Grinder: sit in a vehicle - you are parked on the sky road")
						end
						return
					end
					if vehicle ~= lastVeh then lastVeh, vehParts = vehicle, nil end
					if not vehParts then
						vehParts = {}
						pcall(function()
							for _, p in ipairs(vehicle:GetDescendants()) do
								if p:IsA("BasePart") then table.insert(vehParts, p) end
							end
						end)
					end
					local topY = Flags.SkyStart.Y + 1
					local cz = Flags.SkyStart.Z
					local okP, pv = pcall(function() return vehicle:GetPivot() end)
					if not okP or not pv then return end
					local px = pv.Position.X
					local doneX = px - Flags.SkyStart.X
					if px < Flags.SkyStart.X or doneX >= (SKY.LEN - SKY.EDGE) or pv.Position.Y < (Flags.SkyStart.Y - 80) or (pv.Position - Flags.SkyStart).Magnitude > (SKY.LEN + 400) then
						if doneX >= (SKY.LEN - SKY.EDGE) then
							Flags.SkyLaps = (Flags.SkyLaps or 0) + 1
							pcall(function() console:Write("Miles Grinder: lap " .. tostring(Flags.SkyLaps)) end)
						end
						local startCF = skyStartCF()
						if startCF then
							pcall(function() vehicle:PivotTo(startCF) end)
							if vehParts then for _, p in ipairs(vehParts) do pcall(function() p.AssemblyLinearVelocity = Vector3.zero p.AssemblyAngularVelocity = Vector3.zero end) end end
						end
						return
					end
					-- manual override: holding S/A/D/Space yields the glide to you.
					local held = false
					pcall(function()
						held = UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Space)
					end)
					if held then return end
					-- soft start: ease 15% -> full pace over the first 3 seated seconds.
					if not Flags.SkyRampT0 then Flags.SkyRampT0 = os.clock() end
					local pace = math.clamp(tonumber(AutoDriveSpeed) or 100, 10, 1000) * math.clamp((os.clock() - Flags.SkyRampT0) / 3, 0.15, 1)
					local step = pace * math.min(dt, 0.1)
					Flags.SkyTotal = (Flags.SkyTotal or 0) + step
					local nx = px + step
					pcall(function() vehicle:PivotTo(CFrame.lookAt(Vector3.new(nx, topY + 1, cz), Vector3.new(nx + 10, topY + 1, cz))) end)
					if vehParts then for _, p in ipairs(vehParts) do pcall(function() p.AssemblyLinearVelocity = Vector3.zero p.AssemblyAngularVelocity = Vector3.zero end) end end
					local _, _, hroot = parts()
					if hroot then pcall(function() hroot.AssemblyLinearVelocity = Vector3.zero hroot.AssemblyAngularVelocity = Vector3.zero end) end
					local done = math.clamp(nx - Flags.SkyStart.X, 0, SKY.LEN)
					pcall(function() status:Set(string.format("Status: Miles Grinder - lap %d, %d/%d studs @ %d", Flags.SkyLaps or 0, math.floor(done), SKY.LEN, math.floor(pace))) end)
				end)
			end)
			while Flags.AutoMiles and not Unloaded do
				task.wait(1)
				if not Flags.SkyStart or not Flags.SkyEnd then s, e = buildSkyRoad() end
				-- respawn recovery: on foot and far below the road (died / fell off)
				-- while the farm is on -> lift back onto the pad. Seated cases are
				-- handled by the glide itself (it teleports the car up).
				-- no-progress watchdog (5s window): reset cleanly if gliding but
				-- barely advancing (ownership hiccup, weld jam). Skipped while
				-- you override manually (S/A/D/Space).
				if Flags.SkyStart then
					pcall(function()
						local seatW = seatOf()
						local vehW = seatW and findVehicleOf(seatW)
						if not (seatW and vehW) then Flags.SkyWatchX, Flags.SkyWatchT = nil, nil return end
						local heldW = false
						pcall(function()
							heldW = UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Space)
						end)
						if heldW then Flags.SkyWatchX, Flags.SkyWatchT = nil, nil return end
						local nowW = os.clock()
						local okP, pv = pcall(function() return vehW:GetPivot() end)
						if not okP or not pv then return end
						if not Flags.SkyWatchX then Flags.SkyWatchX, Flags.SkyWatchT = pv.Position.X, nowW return end
						if (nowW - (Flags.SkyWatchT or nowW)) >= 5 then
							local paceW = math.clamp(tonumber(AutoDriveSpeed) or 100, 10, 1000)
							if pv.Position.X < Flags.SkyWatchX + paceW * 2 then
								local startCF = skyStartCF()
								if startCF then pcall(function() vehW:PivotTo(startCF) end) end
								pcall(function() console:Write("Miles Grinder: no progress, reset to start") end)
							end
							Flags.SkyWatchX, Flags.SkyWatchT = pv.Position.X, nowW
						end
					end)
				end
				if Flags.SkyStart and not seatOf() then
					local _, _, r = parts()
					if r and r.Position.Y < (Flags.SkyStart.Y - 80) then
						local backCF = skyStartCF()
						if backCF then moveTo(backCF) end
					end
				end
			end
			pcall(function() if hbConn then hbConn:Disconnect() end end)
			hbConn = nil
			do
				local laps = Flags.SkyLaps or 0
				local total = math.floor(Flags.SkyTotal or 0)
				local secs = math.floor(os.clock() - (Flags.SkyT0 or os.clock()))
				pcall(function() console:Write(string.format("Miles Grinder session: %d laps, %d studs in %ds", laps, total, secs)) end)
			end
			local seat = seatOf()
			if seat and seat:IsA("VehicleSeat") then pcall(function() seat.ThrottleFloat = 0 end) end
			farmReleaseW()
			Flags._milesRunning = false
		end)
	end,
})

