autoFarmToggle = MainTab:AddToggle({
	Title    = "Auto Farm",
	Subtitle = "Sky road, holds W (speed box ignored)",
	Icon     = "car",
	Default  = false,
	Callback = function(state)
		Flags.AutoFarm = state
		report("Auto Farm", state)
		if state and Flags.AutoTraps and trapsToggle then
			trapsToggle:Set(false)
			notify("Auto Farm: paused Speed Traps (they need ground driving)")
		end
		if not state then
			local seat = seatOf()
			if seat and seat:IsA("VehicleSeat") then pcall(function() seat.ThrottleFloat = 0 end) end
			return
		end
		if Flags._farmRunning then return end
		Flags._farmRunning = true
		task.spawn(function()
			local s, e = buildSkyRoad()
			local cf = skyStartCF()
			if cf then moveTo(cf) end
			task.wait(0.5)
			notify("Sky road ready - sit in a vehicle to farm (holds W, speed box ignored)")
			pcall(function() console:Write("Sky road: " .. tostring(math.floor(s.Y)) .. " studs up, length " .. SKY.LEN) end)
			local warnedSeat = false
			local errs = 0
			local dirX0, dirT0, dirDone = nil, os.clock(), false
			local stuckX, stuckT = nil, os.clock()
			while Flags.AutoFarm and not Unloaded do
				local ok = pcall(function()
					if not Flags.SkyStart or not Flags.SkyEnd then
						s, e = buildSkyRoad()
					end
					local seat = seatOf()
					if seat and seat:IsA("VehicleSeat") then
						-- farm never touches MaxSpeed while on: the car just
						-- holds W (Throttle = 1), straight ahead, on its own tune.
						pcall(function()
							seat.ThrottleFloat = 1
							seat.SteerFloat = 0
						end)
					elseif not warnedSeat then
						warnedSeat = true
						notify("Auto Farm: sit in a vehicle - you are parked on the sky road")
					end
					local _, _, root = parts()
					if not root then task.wait(1) return end
					local pos = root.Position
					local doneX = pos.X - Flags.SkyStart.X
					local nearEdge = doneX >= (SKY.LEN - SKY.EDGE)
					local fell = pos.Y < (Flags.SkyStart.Y - 80)
					local lost = (pos - Flags.SkyStart).Magnitude > (SKY.LEN + 400)
					if not dirDone then
						if not dirX0 then
							dirX0, dirT0 = pos.X, os.clock()
						elseif (os.clock() - dirT0) > 3 then
							dirDone = true
							if pos.X < dirX0 - 5 then
								-- car is driving backwards off the pad: flip it 180
								local seatB = seatOf()
								local vb = seatB and findVehicleOf(seatB)
								if vb then
									local okP, pv = pcall(function() return vb:GetPivot() end)
									if okP and pv then
										pcall(function() vb:PivotTo(CFrame.lookAt(pv.Position, pv.Position - pv.LookVector)) end)
										pcall(function() console:Write("Auto Farm: car faced backwards, flipped it") end)
									end
								end
							end
						end
					end
					local seated = seat and seat:IsA("VehicleSeat")
					-- grinding a guard rail pushes Z off-center: pull back to
					-- mid-road (keeps X progress, 1 stud above the top).
					if seated and Flags.SkyStart and math.abs(pos.Z - Flags.SkyStart.Z) > 8 and not (nearEdge or fell or lost) then
						local cy = Flags.SkyStart.Y + 2
						local cz = Flags.SkyStart.Z
						local cx = pos.X + 2
						moveTo(CFrame.lookAt(Vector3.new(cx, cy, cz), Vector3.new(cx + 10, cy, cz)))
						stuckX, stuckT = cx, os.clock()
						pos = Vector3.new(cx, cy, cz)
						doneX = pos.X - Flags.SkyStart.X
					end
					-- fully stuck (leaning on something, W held but no forward
					-- motion): lift 1 stud above the top and nudge onward.
					if seated and not (nearEdge or fell or lost) then
						if not stuckX then
							stuckX, stuckT = pos.X, os.clock()
						elseif (os.clock() - stuckT) > 4 then
							if pos.X < stuckX + 3 then
								local cy2 = Flags.SkyStart.Y + 2
								local cz2 = Flags.SkyStart.Z
								local cx2 = pos.X + 5
								moveTo(CFrame.lookAt(Vector3.new(cx2, cy2, cz2), Vector3.new(cx2 + 10, cy2, cz2)))
								pcall(function() console:Write("Auto Farm: unstuck nudge") end)
								pos = Vector3.new(cx2, cy2, cz2)
								doneX = pos.X - Flags.SkyStart.X
							end
							stuckX, stuckT = pos.X, os.clock()
						end
					end
					if nearEdge or fell or lost then
						local startCF = skyStartCF()
						if startCF then moveTo(startCF) end
						Flags.SkyLaps = (Flags.SkyLaps or 0) + 1
						task.wait(0.4)
					else
						local done = math.clamp(doneX, 0, SKY.LEN)
						pcall(function()
							status:Set(string.format("Status: Auto Farm - lap %d, %d/%d studs", Flags.SkyLaps or 0, math.floor(done), SKY.LEN))
						end)
						task.wait(0.2)
					end
				end)
				if ok then errs = 0 else errs += 1 end
				if errs >= 15 then
					Flags.AutoFarm = false
					notify("Auto Farm stopped: 15 errors in a row")
					break
				end
			end
			local seat = seatOf()
			if seat and seat:IsA("VehicleSeat") then pcall(function() seat.ThrottleFloat = 0 end) end
			Flags._farmRunning = false
		end)
	end,
})

