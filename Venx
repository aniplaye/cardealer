local function parts()
	local char = LP.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return nil end
	return char, hum, root
end

local function seatOf()
	local char, hum = parts()
	if not hum then return nil, nil end
	local seat = hum.SeatPart
	if not seat then return nil, nil end
	return seat, char
end

local function firstPart(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	local found = obj:FindFirstChildWhichIsA("BasePart", true)
	return found
end

-- Single shared prompt cache: one workspace scan every few seconds.
-- Before this, every farm/race loop scanned ALL of workspace on every
-- teleport (up to ~10 full scans/sec with 2-3 toggles) which froze low-end
-- devices until threads looked "suddenly stopped".
local PromptCache = {}
local PromptCacheAt = 0
task.spawn(function()
	while not Unloaded do
		local ok = pcall(function()
			local found = {}
			for _, p in ipairs(workspace:GetDescendants()) do
				if p:IsA("ProximityPrompt") then
					table.insert(found, p)
				end
			end
			PromptCache = found
			PromptCacheAt = os.clock()
		end)
		if not ok then task.wait(2) else task.wait(4) end
	end
end)

local function fireNearbyPrompts(pos, radius)
	local r = radius or 14
	for _, p in ipairs(PromptCache) do
		local ok, parent, pp = pcall(function()
			local par = firstPart(p.Parent)
			return par, par and par.Position
		end)
		if ok and parent and pp and (pp - pos).Magnitude <= r then
			pcall(fireproximityprompt, p)
		end
	end
end

local function tryTouch(part)
	if typeof(firetouchinterest) ~= "function" then return end
	local _, _, root = parts()
	if not root or not part then return end
	pcall(function()
		firetouchinterest(root, part, 0)
		task.wait(0.15)
		firetouchinterest(root, part, 1)
	end)
end

local function collectTarget(part, radius)
	if not part then return end
	moveTo(part.CFrame + Vector3.new(0, 3, 0))
	-- prompts parented directly to the target first (cheap: single part, no model scan)
	pcall(function()
		for _, d in ipairs(part:GetDescendants()) do
			if d:IsA("ProximityPrompt") then pcall(fireproximityprompt, d) end
		end
	end)
	fireNearbyPrompts(part.Position, radius or 14)
	tryTouch(part)
end

-- CDT collectible pickup (Components.Collectible in the place file):
-- stand within the group's CollectionRadius, then
-- CollectibleServiceRemotes.Collect:InvokeServer(groupName, itemName).
-- Group = tagged model's parent folder name; item = model name.
local function collectGameItem(part)
	if not part then return false end
	local model = part
	pcall(function()
		local n = part
		while n and n.Parent and n.Parent ~= workspace do
			local okT, tagged = pcall(function() return CollectionService:HasTag(n, "Collectible_Model") end)
			if okT and tagged then model = n break end
			n = n.Parent
		end
	end)
	local group, item
	pcall(function() group = model.Parent and model.Parent.Name end)
	pcall(function() item = model.Name end)
	if not group or not item then return false end
	local r = collectRadiusOf(group)
	local okP, pp = pcall(function() return part.Position end)
	if okP and pp then
		local _, _, root = parts()
		if root and (pp - root.Position).Magnitude > math.max(4, r - 2) then
			moveTo(part.CFrame + Vector3.new(0, 3, 0))
		end
	end
	fireNearbyPrompts(part.Position, 16)
	tryTouch(part)
	local rf = findRemote("Collect", "RemoteFunction")
	if not rf then return false end
	local ok, res = pcall(function() return rf:InvokeServer(group, item) end)
	return ok and res
end

local function findVehicleOf(seat)
	if not seat then return nil end
	-- deobfuscated.lua trace saw SeatPart.Parent.Parent, but nesting varies:
	-- climb ancestors and take the highest Model (the actual car), not workspace.
	local node, top = seat.Parent, nil
	while node and node ~= workspace do
		local ok, isModel = pcall(function() return node:IsA("Model") end)
		if ok and isModel then top = node end
		node = node.Parent
	end
	return top
end

local function moveTo(cf)
	local seat = seatOf()
	if seat then
		local vehicle = findVehicleOf(seat)
		if not vehicle then
			-- legacy fallback: exact deobf chain
			local v = seat.Parent and seat.Parent.Parent
			pcall(function() if v and v:IsA("Model") then vehicle = v end end)
		end
		if vehicle then
			local ok = pcall(function()
				for _, p in ipairs(vehicle:GetDescendants()) do
					if p:IsA("BasePart") then
						p.AssemblyLinearVelocity = Vector3.zero
						p.AssemblyAngularVelocity = Vector3.zero
					end
				end
				vehicle:PivotTo(cf)
			end)
			if ok then return true end
		end
	end
	local _, _, root = parts()
	if root then
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end)
		return true
	end
	return false
end

