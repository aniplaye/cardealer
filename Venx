local function collectRaceParts(raceRoot)
	local strict, fallback = {}, {}
	for _, d in ipairs(raceRoot:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = d.Name:lower()
			if n:find("checkpoint") or n:find("check") or n == "cp"
				or n:find("lap") or n:find("start") or n:find("finish")
				or n:find("gate") or n:find("ring") then
				table.insert(strict, d)
			else
				table.insert(fallback, d)
			end
		end
	end
	if #strict > 0 then return numericNameSort(strict) end
	return numericNameSort(fallback)
end

local function driveCheckpoints(flagKey, runningKey, mode)
	Flags[flagKey] = true
	if Flags[runningKey] then return end
	Flags[runningKey] = true
	task.spawn(function()
		local warnedSeat = false
		local stallN = 0
		while Flags[flagKey] and not Unloaded do
			local did = false
			pcall(function()
				local races = workspace:FindFirstChild("Races")
				if not races then
					pcall(function() status:Set("Status: Race - workspace.Races not found") end)
					return
				end
				local roots = {}
				if SelectedRace and SelectedRace ~= "All" then
					local one = races:FindFirstChild(SelectedRace)
					if one then table.insert(roots, one) end
				else
					roots = races:GetChildren()
				end
				if #roots == 0 then
					pcall(function() status:Set("Status: Race - no races (use Refresh)") end)
					return
				end
				for _, root in ipairs(roots) do
					if not Flags[flagKey] or Unloaded then break end
					local cps = collectRaceParts(root)
					if #cps == 0 then
						pcall(function() status:Set("Status: Race - no parts in " .. root.Name) end)
					else
						for i, cp in ipairs(cps) do
							if not Flags[flagKey] or Unloaded then break end
							did = true
							local seat = seatOf()
							local speed = AutoRaceSpeed * ((mode == "drift") and 1.5 or 1)
							if seat and seat:IsA("VehicleSeat") then
								pcall(function() seat.MaxSpeed = speed end)
							else
								if not warnedSeat then
									warnedSeat = true
									notify("Race: sit in a vehicle for vehicle races")
								end
							end
							pcall(function()
								status:Set("Status: Race " .. root.Name .. " " .. i .. "/" .. #cps)
							end)
							collectTarget(cp, 16)
							task.wait(mode == "drift" and 0.4 or 0.6)
						end
					end
				end
			end)
			if did then stallN = 0 else stallN += 1 end
			if stallN == 10 then
				pcall(function() status:Set("Status: Race - waiting for checkpoints...") end)
			end
			if not did then task.wait(1.5) end
		end
		local seat = seatOf()
		if seat and seat:IsA("VehicleSeat") then pcall(function() seat.ThrottleFloat = 0 end) end
		Flags[runningKey] = false
	end)
end

