MainTab:AddToggle({
	Title    = "Auto Collect Pumpkins",
	Subtitle = "Farms pumpkins + all collectables",
	Icon     = "flask-conical",
	Default  = false,
	Callback = function(state)
		Flags.AutoPumpkins = state
		report("Auto Collect Pumpkins", state)
		if not state or Flags._pumpkinsRunning then return end
		if #findCollectableFolders() == 0 then
			notify("No collectables found (no pumpkin/collect folder)")
			Flags.AutoPumpkins = false
			return
		end
		Flags._pumpkinsRunning = true
		task.spawn(function()
			local pumpErrs = 0
			while Flags.AutoPumpkins and not Unloaded do
				local folders = findCollectableFolders()
				if #folders == 0 then
					pcall(function() status:Set("Status: Collectables - none found, waiting") end)
					task.wait(2)
				else
					-- gather from every collectable folder (pumpkins are direct children,
					-- Collectibles are nested): cap + nearest-first so big maps stay smooth
					local targets, seen = {}, {}
					local from = hrpPos()
					for _, folder in ipairs(folders) do
						local kids = {}
						pcall(function() kids = folder:GetChildren() end)
						for _, kid in ipairs(kids) do
							local part
							pcall(function() part = firstPart(kid) end)
							if part and not seen[part] then
								seen[part] = true
								table.insert(targets, part)
								if #targets >= 60 then break end
							end
						end
						if #targets >= 60 then break end
						if #targets < 60 then
							for _, d in ipairs(cachedDescs(folder, true)) do
								if not seen[d] then
									seen[d] = true
									table.insert(targets, d)
									if #targets >= 60 then break end
								end
							end
						end
						if #targets >= 60 then break end
					end
					if #targets == 0 then
						task.wait(1)
					else
						sortedByDistance(targets, from)
						for _, part in ipairs(targets) do
							if not Flags.AutoPumpkins or Unloaded then break end
							local okItem = pcall(function()
									collectGameItem(part) -- CDT: Collect:InvokeServer(group, item) within radius
							end)
							if okItem then pumpErrs = 0 else pumpErrs += 1 end
							if pumpErrs >= 15 then
								Flags.AutoPumpkins = false
								notify("Auto Collect stopped: 15 errors in a row")
								break
							end
							task.wait(0.5)
						end
					end
				end
			end
			Flags._pumpkinsRunning = false
		end)
	end,
})

