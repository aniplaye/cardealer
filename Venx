local function driveCheckpoints(flagKey, runningKey, label)
	Flags[flagKey] = true
	if Flags[runningKey] then return end
	Flags[runningKey] = true
	task.spawn(function()
		while Flags[flagKey] and not Unloaded do
			local did = false
			pcall(function()
				local races = workspace:FindFirstChild("Races")
				if races then
					-- deobfuscated.lua: race toggles drive checkpoints at AutoRaceSpeed
					local seat = seatOf()
					if seat and seat:IsA("VehicleSeat") then seat.MaxSpeed = AutoRaceSpeed end
					for _, cp in ipairs(races:GetDescendants()) do
						if not Flags[flagKey] or Unloaded then break end
						if cp:IsA("BasePart") and (cp.Name:lower():find("checkpoint") or cp.Name:lower():find("lap")) then
							did = true
							moveTo(cp.CFrame)
							task.wait(0.3)
						end
					end
				end
			end)
			if not did then task.wait(1) end
		end
		Flags[runningKey] = false
	end)
end

