-- Race parts are cached per race: scanning GetDescendants() on every lap froze
-- big Halloween races until the game had to be closed. Compute once per toggle.
local RaceCache = {}
local function clearRaceCache() RaceCache = {} end
local function collectRaceParts(raceRoot)
	local key = tostring(raceRoot:GetFullName())
	if RaceCache[key] then return RaceCache[key] end
	local strict, fallback = {}, {}
	-- CDT tags the real gates: RaceHandler reads GetTagged("Checkpoints"/"GoalCheckpoints")
	pcall(function()
		for _, tag in ipairs({ "Checkpoints", "GoalCheckpoints" }) do
			local okT, tagged = pcall(function() return CollectionService:GetTagged(tag) end)
			if okT and tagged then
				for _, inst in ipairs(tagged) do
					local okD, inside = pcall(function() return inst:IsDescendantOf(raceRoot) end)
					if okD and inside then
						local okP, isP = pcall(function() return inst:IsA("BasePart") end)
						if okP and isP and #strict < 150 then table.insert(strict, inst) end
					end
				end
			end
		end
	end)
	local descs = {}
	if #strict == 0 then
		pcall(function() descs = raceRoot:GetDescendants() end)
	end
	for _, d in ipairs(descs) do
		local okIs = false
		pcall(function() okIs = d:IsA("BasePart") end)
		if okIs then
			local okN, n = pcall(function() return d.Name:lower() end)
			if okN and n then
				if n:find("checkpoint") or n:find("check") or n == "cp"
					or n:find("lap") or n:find("start") or n:find("finish")
					or n:find("gate") or n:find("ring") then
					table.insert(strict, d)
				else
					if #fallback < 40 then table.insert(fallback, d) end
				end
				if #strict >= 150 then break end
			end
		end
		if #strict >= 150 then break end
	end
	local out
	if #strict > 0 then
		out = numericNameSort(strict)
	else
		out = numericNameSort(fallback)
	end
	if #out > 150 then
		local trimmed = {}
		for i = 1, 150 do trimmed[i] = out[i] end
		out = trimmed
	end
	RaceCache[key] = out
	return out
end

local function collectRacePoint(cp)
	if not cp then return end
	moveTo(cp.CFrame + Vector3.new(0, 3, 0))
	-- fast path: cached prompts + touch only (no parent-model scan: that froze Halloween races)
	pcall(function()
		local okPos, pp = pcall(function() return cp.Position end)
		if okPos and pp then fireNearbyPrompts(pp, 16) end
	end)
	tryTouch(cp)
end

local function findRaceFolders()
	local folders = {}
	local function push(f) if f then table.insert(folders, f) end end
	push(workspace:FindFirstChild("Races"))
	-- broad sweep: anything with race/halloween in the name that could hold a course
	pcall(function()
		for _, kid in ipairs(workspace:GetChildren()) do
			local okN, n = pcall(function() return kid.Name:lower() end)
			if okN and n and (n:find("race") or n:find("halloween")) then
				local dup = false
				for _, f in ipairs(folders) do if f == kid then dup = true break end end
				if not dup and (kid:IsA("Folder") or kid:IsA("Model")) then
					push(kid)
				end
			end
		end
	end)
	return folders
end

local function findHalloweenRoot()
	for _, folder in ipairs(findRaceFolders()) do
		local ok, kids = pcall(function() return folder:GetChildren() end)
		if ok and kids then
			for _, r in ipairs(kids) do
				local okN, n = pcall(function() return r.Name:lower() end)
				if okN and n and n:find("halloween") then return r, folder end
			end
		end
	end
	return nil, nil
end

local function findRaceRootByName(name)
	for _, folder in ipairs(findRaceFolders()) do
		local f = folder:FindFirstChild(name)
		if f then return f end
	end
	return nil
end

