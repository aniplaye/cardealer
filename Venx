local function freshRacePoints(raceRoot)
	local strict, fallback = {}, {}
	for _, d in ipairs(raceRoot:GetDescendants()) do
		local okP = false
		pcall(function() okP = d:IsA("BasePart") end)
		if okP then
			local okN, n = pcall(function() return d.Name:lower() end)
			if okN and n then
				if n:find("checkpoint") or n:find("check") or n == "cp"
					or n:find("lap") or n:find("start") or n:find("finish")
					or n:find("gate") or n:find("ring") then
					strict[#strict + 1] = d
				else
					if #fallback < 40 then fallback[#fallback + 1] = d end
				end
				if #strict >= 150 then break end
			end
		end
	end
	local out = (#strict > 0) and strict or fallback
	pcall(function()
		table.sort(out, function(a, b) return a.Name < b.Name end)
	end)
	return out
end

