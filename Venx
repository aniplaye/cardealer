-- CDT delivery = ActionTasksGames items (see InteractHandler): teleport to
-- each *DeliveryGame* item and fire TryInteractWithItem for it.
local function deliveryInteract()
		local games = workspace:FindFirstChild("ActionTasksGames")
		if not games then return false end
		local item, gname
		pcall(function()
			for _, d in ipairs(games:GetDescendants()) do
			if d:IsA("BasePart") then
			local p = d.Parent
			local okN, n = pcall(function() return p and p.Name or "" end)
			if okN and n:find("DeliveryGame") then item, gname = d, n break end
			end
			end
		end)
		if not item then return false end
		moveTo(item.CFrame + Vector3.new(0, 3, 0))
		tryTouch(item)
		fireNearbyPrompts(item.Position, 14)
		local ar = findRemote("ActionGameDataReplication", "RemoteEvent")
		if ar then pcall(function() ar:FireServer("TryInteractWithItem", { GameName = gname, ItemId = item.Name }) end) end
		return true
end

