local function safePosOf(obj, fromPos)
	local ok, p = pcall(function()
		local part = firstPart(obj)
		if part then return (part.Position - fromPos).Magnitude end
		return nil
	end)
	if ok then return p end
	return nil
end

local function sortedByDistance(list, fromPos)
	if not fromPos then return list end
	-- instances can despawn mid-sort (collectibles); never let that kill the loop
	local dist = {}
	for _, o in ipairs(list) do
		dist[o] = safePosOf(o, fromPos) or math.huge
	end
	pcall(function()
		table.sort(list, function(a, b) return (dist[a] or math.huge) < (dist[b] or math.huge) end)
	end)
	return list
end

-- Cached folder scans: Collectibles/SpeedCameras rescanned every pass froze big maps.
-- Cache for 10s, refreshed in background while the loop runs.
local FolderCache = {}
local function cachedDescs(folder, wantParts)
	local key = tostring(folder:GetFullName())
	local now = os.clock()
	local hit = FolderCache[key]
	if hit and (now - hit.at) < 10 then return hit.list end
	local list = {}
	pcall(function()
		for _, d in ipairs(folder:GetDescendants()) do
			local okP = false
			pcall(function() okP = wantParts and d:IsA("BasePart") or true end)
			if okP then
				table.insert(list, d)
				if #list >= 200 then break end
			end
		end
	end)
	FolderCache[key] = { at = now, list = list }
	return list
end

local function findCollectableFolders()
	local folders = {}
	local function push(f)
		if not f then return end
		for _, e in ipairs(folders) do if e == f then return end end
		table.insert(folders, f)
	end
	push(workspace:FindFirstChild("HalloweenPumpkinsLocal"))
	push(workspace:FindFirstChild("Collectibles"))
	push(workspace:FindFirstChild("Halloween2026"))
	push(workspace:FindFirstChild("Halloween"))
	push(workspace:FindFirstChild("Pickups"))
	pcall(function()
		for _, kid in ipairs(workspace:GetChildren()) do
			if kid:IsA("Folder") or kid:IsA("Model") then
				local okN, n = pcall(function() return kid.Name:lower() end)
				if okN and n and n:find("collect") then push(kid) end
			end
		end
	end)
	return folders
end

-- ===== CDT remote resolver (Knit services move between updates) =====
-- Resolve any RemoteEvent/RemoteFunction by (name, class) once, then cache.
-- Falls back to a full re-scan when something replicates late.
local RemoteMap = nil
local function remoteMap()
	if RemoteMap then return RemoteMap end
	RemoteMap = {}
	pcall(function()
		for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
			pcall(function()
				if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
					RemoteMap[d.ClassName .. "\0" .. d.Name] = d
				end
			end)
		end
	end)
	return RemoteMap
end
local function findRemote(name, class)
	class = class or "RemoteEvent"
	local hit = remoteMap()[class .. "\0" .. name]
	if hit then return hit end
	RemoteMap = nil -- replicated late? rescan once
	return remoteMap()[class .. "\0" .. name]
end

