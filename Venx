			pcall(function() console:Write("Auto Farm: cruising in " .. tostring(carName)) end)
			while Flags.AutoDrive and not Unloaded do
				pcall(function() status:Set("Status: Auto Farm - cruising (" .. tostring(carName) .. ")") end)
