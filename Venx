-- Observed: 7x readfile, split(" "), indices 1,2,3, then warn "Config Loaded" + values
local function loadDeliveryConfig()
  local raw = readfile("cdtdelivery.txt") -- "3 5000 20000"
  local parts = raw:split(" ")
  local stars, minReward, maxReward = parts[1], parts[2], parts[3]
  warn("_____________________________________Config Loaded_____________________________________\nStars: "..tostring(stars).."\nMinimum reward money: "..tostring(minReward).."\nMaximum reward money: "..tostring(maxReward))
