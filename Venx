					if FreshRace == "All" or r.Name == FreshRace then
						local cps = freshRacePoints(r)
						if #cps > 0 then
							freshGoto(cps[1].CFrame + Vector3.new(0, 4, 0))
							freshStatus("Status: at race " .. r.Name)
							done = true
							break
						end
					end
				end
				if done then break end
			end
		end)
		if not done then freshNotify("No race start found (try Refresh in Race tab)") end
	end,
})

