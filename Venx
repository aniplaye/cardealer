-- ===== Sky-road autofarm (client-sided, 1000 studs up) =====
-- Classic dealership farm: a long private road in the sky. Drive it, and when
-- you reach the edge you are put back at the start. Client-sided parts do not
-- replicate (FilteringEnabled), so other players do not see this road.
local SKY = { LEN = 2200, WIDTH = 26, Y_OFF = 1000, EDGE = 160 }
local function destroySkyRoad()
	pcall(function()
		local old = workspace:FindFirstChild("VenasSkyRoad")
		if old then old:Destroy() end
	end)
	Flags.SkyStart, Flags.SkyEnd, Flags.SkyLaps = nil, nil, nil
end
local function buildSkyRoad()
	destroySkyRoad()
	local _, _, root = parts()
	local origin = ((root and root.Position) or Vector3.new(0, 50, 0)) + Vector3.new(0, SKY.Y_OFF, 0)
	local s = origin
	local e = origin + Vector3.new(SKY.LEN, 0, 0)
	local folder = Instance.new("Folder")
	folder.Name = "VenasSkyRoad"
	pcall(function() folder.Parent = workspace end)
	local function mkPart(name, size, cf, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Anchored = true
		p.CanCollide = true
		if color then p.Color = color end
		p.Material = Enum.Material.SmoothPlastic
		p.Parent = folder
		return p
	end
	local mid = (s + e) / 2
	mkPart("Road", Vector3.new(SKY.LEN, 2, SKY.WIDTH), CFrame.new(mid), Color3.fromRGB(30, 30, 35))
	-- low guard rails so you do not slide off sideways
	mkPart("RailL", Vector3.new(SKY.LEN, 6, 1), CFrame.new(mid + Vector3.new(0, 4, SKY.WIDTH / 2)), Color3.fromRGB(200, 60, 60))
	mkPart("RailR", Vector3.new(SKY.LEN, 6, 1), CFrame.new(mid + Vector3.new(0, 4, -SKY.WIDTH / 2)), Color3.fromRGB(200, 60, 60))
	-- bright start pad so you can see the loop point
	mkPart("StartPad", Vector3.new(12, 2.4, SKY.WIDTH), CFrame.new(s), Color3.fromRGB(60, 200, 120))
	Flags.SkyStart, Flags.SkyEnd, Flags.SkyLaps = s, e, 0
	return s, e
end
local function skyStartCF()
	local s = Flags.SkyStart
	if not s then return nil end
	local p = s + Vector3.new(0, 6, 0)
	return CFrame.lookAt(p, p + Vector3.new(1, 0, 0))
end

