-- CDT pickup: stand in radius, then Collect:InvokeServer(groupName, itemName).
-- Group = tagged model's parent folder, item = model name.
local function freshCollectPart(part)
	if not part then return false end
	local model = part
	pcall(function()
		local n = part
		while n and n.Parent and n.Parent ~= workspace do
			local okT, tagged = pcall(function() return CollectionService:HasTag(n, "Collectible_Model") end)
			if okT and tagged then model = n break end
			n = n.Parent
		end
	end)
	local group, item = nil, nil
	pcall(function() group = model.Parent and model.Parent.Name end)
	pcall(function() item = model.Name end)
	if not group or not item then return false end
	local r = freshRadiusOf(group)
	local okP, pp = pcall(function() return part.Position end)
	if okP and pp then
		local me = freshHrpPos()
		if me and (pp - me).Magnitude > math.max(4, r - 2) then
			freshGoto(part.CFrame + Vector3.new(0, 3, 0))
		end
	end
	freshPromptBurst(part.Position, 16)
	freshTouch(part)
	local rf = freshRemote("Collect", "RemoteFunction")
	if not rf then return false end
	local ok, res = pcall(function() return rf:InvokeServer(group, item) end)
	if ok then return res ~= nil end
	return false
end

-- ===== NEW physics driver (no teleports while driving) =====
-- Faces the car with rotation-only PivotTo snaps at its CURRENT position,
-- then holds real throttle. Position never teleports, so no rubber-banding.
local function freshSteerTo(targetPos, speed, timeoutS, flagKey, arriveR)
	timeoutS = timeoutS or 20
	arriveR = arriveR or 30
	local t0 = os.clock()
	local lastProg, lastT, hops = nil, os.clock(), 0
	while Fresh[flagKey] and not FreshOff and (os.clock() - t0) < timeoutS do
		local seat = freshSeat()
		if not seat or not seat:IsA("VehicleSeat") then return false end
		local car = freshCar(seat)
		if not car then return false end
		local okP, pivot = pcall(function() return car:GetPivot() end)
		if not okP or not pivot then task.wait(0.3) else
			local pos = pivot.Position
			local flat = Vector3.new(targetPos.X - pos.X, 0, targetPos.Z - pos.Z)
			local dist = flat.Magnitude
			if dist < arriveR then
				pcall(function()
					seat.MaxSpeed = speed
					seat.ThrottleFloat = 1
					seat.SteerFloat = 0
				end)
				task.wait(0.4)
				return true
			end
			if lastProg and (lastProg - dist) < 1 and (os.clock() - lastT) > 4 then
				hops = hops + 1
				lastT = os.clock()
				if hops == 1 then
					-- reverse out first (usually enough)
					pcall(function()
						seat.ThrottleFloat = -1
						seat.SteerFloat = 0
					end)
					task.wait(1.2)
					pcall(function() seat.ThrottleFloat = 1 end)
				else
					-- small vertical hop as last resort, then keep driving
					pcall(function() car:PivotTo(pivot + Vector3.new(0, 8, 0)) end)
					return false
				end
			else
				if (not lastProg) or (lastProg - dist) >= 1 then
					lastProg, lastT = dist, os.clock()
				end
			end
			if flat.Magnitude > 0.5 then
				pcall(function()
					car:PivotTo(CFrame.lookAt(pos, pos + flat))
				end)
			end
			pcall(function()
				seat.MaxSpeed = speed
				seat.ThrottleFloat = 1
				seat.SteerFloat = 0
			end)
			task.wait(0.3)
		end
	end
	return false
end

