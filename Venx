			local dest = workspace.Races:FindFirstChild(selected)
			local part = firstPart(dest)
			if part then
				moveTo(part.CFrame + Vector3.new(0, 5, 0))
			end
		end)
		pcall(function() console:Write("Race teleport: " .. tostring(selected)) end)
		pcall(function() status:Set("Status: teleported " .. tostring(selected)) end)
	end,
})

