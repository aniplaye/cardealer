				pcall(function() Fresh._potConn:Disconnect() end)
				Fresh._potConn = nil
			end
			local S = Fresh._potSaved
			if S then
				pcall(function()
					local L = game:GetService("Lighting")
					if S.Quality then settings().Rendering.QualityLevel = S.Quality end
					if S.Shadows ~= nil then L.GlobalShadows = S.Shadows end
				end)
				Fresh._potSaved = nil
			end
			freshNotify("Potato off - rejoin restores textures")
			return
		end
		pcall(function()
			local L = game:GetService("Lighting")
			local R = settings().Rendering
			local S = {}
			S.Quality = R.QualityLevel
			S.Shadows = L.GlobalShadows
			R.QualityLevel = Enum.QualityLevel.Level01
			L.GlobalShadows = false
			Fresh._potSaved = S
		end)
		if not Fresh._potConn then
			Fresh._potConn = workspace.DescendantAdded:Connect(function(d)
				if Fresh.Potato and not FreshOff then
					pcall(function()
						if d:IsA("BasePart") then
							d.Material = Enum.Material.SmoothPlastic
