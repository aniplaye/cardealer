local function freshPromptBurst(pos, radius)
	radius = radius or 16
	for _, p in ipairs(FreshPrompts) do
		local ok, pp = pcall(function()
			local par = freshFirstPart(p.Parent)
			return par and par.Position
		end)
		if ok and pp and (pp - pos).Magnitude <= radius then
			pcall(fireproximityprompt, p)
		end
	end
end

