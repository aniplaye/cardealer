local function freshCollectFolders()
	local out, seen = {}, {}
	local function push(f)
		if not f then return end
		for _, e in ipairs(out) do if e == f then return end end
		if seen[f] then return end
		seen[f] = true
		out[#out + 1] = f
	end
	push(workspace:FindFirstChild("HalloweenPumpkinsLocal"))
	push(workspace:FindFirstChild("Collectibles"))
	push(workspace:FindFirstChild("Halloween2026"))
	push(workspace:FindFirstChild("Halloween"))
	push(workspace:FindFirstChild("Pickups"))
	pcall(function()
		for _, kid in ipairs(workspace:GetChildren()) do
			local okN, n = pcall(function() return kid.Name:lower() end)
			if okN and n and n:find("collect") then push(kid) end
		end
	end)
	return out
end

collectToggle = MainTab:AddToggle({
	Title = "Auto Collect",
	Subtitle = "Pumpkins + all collectables (teleport pickup)",
	Icon = "package",
	Default = false,
	Callback = function(state)
		Fresh.Collect = state
		freshLog("Auto Collect " .. (state and "enabled" or "disabled"))
		freshStatus("Status: Auto Collect " .. (state and "on" or "off"))
		if not state or Fresh._collectRunning then return end
		Fresh._collectRunning = true
		task.spawn(function()
			local errs = 0
			while Fresh.Collect and not FreshOff do
				local folders = freshCollectFolders()
				if #folders == 0 then
					freshStatus("Status: Collect - nothing found, waiting")
					task.wait(2)
				else
					local targets, seenT = {}, {}
					local me = freshHrpPos()
					for _, folder in ipairs(folders) do
						local kids = {}
						pcall(function() kids = folder:GetChildren() end)
						for _, kid in ipairs(kids) do
							local part = freshFirstPart(kid)
							if part and not seenT[part] then
								seenT[part] = true
								targets[#targets + 1] = part
								if #targets >= 60 then break end
							end
						end
						if #targets >= 60 then break end
						if #targets < 60 then
							local descs = {}
							pcall(function() descs = folder:GetDescendants() end)
							local n = 0
							for _, d in ipairs(descs) do
								local okP = false
								pcall(function() okP = d:IsA("BasePart") end)
								if okP and not seenT[d] then
									seenT[d] = true
									targets[#targets + 1] = d
									n = n + 1
									if #targets >= 60 or n >= 200 then break end
								end
							end
						end
						if #targets >= 60 then break end
					end
					if #targets == 0 then
						task.wait(1)
					else
						if me then
							local dist = {}
							for _, o in ipairs(targets) do
								local okD, p = pcall(function()
									return (freshFirstPart(o).Position - me).Magnitude
								end)
								dist[o] = (okD and p) or math.huge
							end
							pcall(function()
								table.sort(targets, function(a, b)
									return (dist[a] or math.huge) < (dist[b] or math.huge)
								end)
							end)
						end
						for _, part in ipairs(targets) do
							if not Fresh.Collect or FreshOff then break end
							local okC = pcall(function() freshCollectPart(part) end)
							if okC then errs = 0							Fresh.Collected = (Fresh.Collected or 0) + 1							else errs = errs + 1 end
							if errs >= 15 then
								Fresh.Collect = false
								freshNotify("Auto Collect stopped: 15 errors in a row")
								break
							end
							task.wait(0.5)
						end
					end
				end
			end
			Fresh._collectRunning = false
		end)
	end,
})

