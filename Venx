local function numericNameSort(list)
	table.sort(list, function(a, b)
		local na, nb = a.Name, b.Name
		local xa, xb = na:match("(%d+)"), nb:match("(%d+)")
		if xa and xb and na:gsub("%d+", "#") == nb:gsub("%d+", "#") then
			return tonumber(xa) < tonumber(xb)
		end
		return na < nb
	end)
	return list
end



