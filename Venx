local function parts()
	local char = LP.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return nil end
	return char, hum, root
end

local function seatOf()
	local char, hum = parts()
	if not hum then return nil, nil end
	local seat = hum.SeatPart
	if not seat then return nil, nil end
	return seat, char
end

local function firstPart(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	local found = obj:FindFirstChildWhichIsA("BasePart", true)
	return found
end

-- Single shared prompt cache: one workspace scan every few seconds.
-- Before this, every farm/race loop scanned ALL of workspace on every
-- teleport (up to ~10 full scans/sec with 2-3 toggles) which froze low-end
-- devices until threads looked "suddenly stopped".
local PromptCache = {}
local PromptCacheAt = 0
task.spawn(function()
	while not Unloaded do
		local ok = pcall(function()
			local found = {}
			for _, p in ipairs(workspace:GetDescendants()) do
				if p:IsA("ProximityPrompt") then
					table.insert(found, p)
				end
			end
			PromptCache = found
			PromptCacheAt = os.clock()
		end)
		if not ok then task.wait(2) else task.wait(4) end
	end
end)

local function fireNearbyPrompts(pos, radius)
	local r = radius or 14
	for _, p in ipairs(PromptCache) do
		local ok, parent, pp = pcall(function()
			local par = firstPart(p.Parent)
			return par, par and par.Position
		end)
		if ok and parent and pp and (pp - pos).Magnitude <= r then
			pcall(fireproximityprompt, p)
		end
	end
end

local function tryTouch(part)
	if typeof(firetouchinterest) ~= "function" then return end
	local _, _, root = parts()
	if not root or not part then return end
	pcall(function()
		firetouchinterest(root, part, 0)
		task.wait(0.15)
		firetouchinterest(root, part, 1)
	end)
end

local function collectTarget(part, radius)
	if not part then return end
	moveTo(part.CFrame + Vector3.new(0, 3, 0))
	-- prompts parented directly to the target first (cheap: single part, no model scan)
	pcall(function()
		for _, d in ipairs(part:GetDescendants()) do
			if d:IsA("ProximityPrompt") then pcall(fireproximityprompt, d) end
		end
	end)
	fireNearbyPrompts(part.Position, radius or 14)
	tryTouch(part)
end

local function findVehicleOf(seat)
	if not seat then return nil end
	-- deobfuscated.lua trace saw SeatPart.Parent.Parent, but nesting varies:
	-- climb ancestors and take the highest Model (the actual car), not workspace.
	local node, top = seat.Parent, nil
	while node and node ~= workspace do
		local ok, isModel = pcall(function() return node:IsA("Model") end)
		if ok and isModel then top = node end
		node = node.Parent
	end
	return top
end

local function moveTo(cf)
	local seat = seatOf()
	if seat then
		local vehicle = findVehicleOf(seat)
		if not vehicle then
			-- legacy fallback: exact deobf chain
			local v = seat.Parent and seat.Parent.Parent
			pcall(function() if v and v:IsA("Model") then vehicle = v end end)
		end
		if vehicle then
			local ok = pcall(function()
				for _, p in ipairs(vehicle:GetDescendants()) do
					if p:IsA("BasePart") then
						p.AssemblyLinearVelocity = Vector3.zero
						p.AssemblyAngularVelocity = Vector3.zero
					end
				end
				vehicle:PivotTo(cf)
			end)
			if ok then return true end
		end
	end
	local _, _, root = parts()
	if root then
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end)
		return true
	end
	return false
end

local function hrpPos()
	local _, _, root = parts()
	return root and root.Position
end

local function safePosOf(obj, fromPos)
	local ok, p = pcall(function()
		local part = firstPart(obj)
		if part then return (part.Position - fromPos).Magnitude end
		return nil
	end)
	if ok then return p end
	return nil
end

local function sortedByDistance(list, fromPos)
	if not fromPos then return list end
	-- instances can despawn mid-sort (collectibles); never let that kill the loop
	local dist = {}
	for _, o in ipairs(list) do
		dist[o] = safePosOf(o, fromPos) or math.huge
	end
	pcall(function()
		table.sort(list, function(a, b) return (dist[a] or math.huge) < (dist[b] or math.huge) end)
	end)
	return list
end

-- Cached folder scans: Collectibles/SpeedCameras rescanned every pass froze big maps.
-- Cache for 10s, refreshed in background while the loop runs.
local FolderCache = {}
local function cachedDescs(folder, wantParts)
	local key = tostring(folder:GetFullName())
	local now = os.clock()
	local hit = FolderCache[key]
	if hit and (now - hit.at) < 10 then return hit.list end
	local list = {}
	pcall(function()
		for _, d in ipairs(folder:GetDescendants()) do
			local okP = false
			pcall(function() okP = wantParts and d:IsA("BasePart") or true end)
			if okP then
				table.insert(list, d)
				if #list >= 200 then break end
			end
		end
	end)
	FolderCache[key] = { at = now, list = list }
	return list
end

local function findCollectableFolders()
	local folders = {}
	local function push(f)
		if not f then return end
		for _, e in ipairs(folders) do if e == f then return end end
		table.insert(folders, f)
	end
	push(workspace:FindFirstChild("HalloweenPumpkinsLocal"))
	push(workspace:FindFirstChild("Collectibles"))
	pcall(function()
		for _, kid in ipairs(workspace:GetChildren()) do
			if kid:IsA("Folder") or kid:IsA("Model") then
				local okN, n = pcall(function() return kid.Name:lower() end)
				if okN and n and n:find("collect") then push(kid) end
			end
		end
	end)
	return folders
end

local function numericNameSort(list)
	table.sort(list, function(a, b)
		local na, nb = a.Name, b.Name
		local xa, xb = na:match("(%d+)"), nb:match("(%d+)")
		if xa and xb and na:gsub("%d+", "#") == nb:gsub("%d+", "#") then
			return tonumber(xa) < tonumber(xb)
		end
		return na < nb
	end)
	return list
end

