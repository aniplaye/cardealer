local function freshChar()
	local char = LP.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return nil end
	return char, hum, root
end

local function freshSeat()
	local _, hum = freshChar()
	if not hum then return nil end
	local seat = hum.SeatPart
	if not seat then return nil end
	return seat
end

-- top-most vehicle Model above the seat (nesting varies per chassis)
local function freshCar(seat)
	if not seat then return nil end
	local node, top = seat.Parent, nil
	while node and node ~= workspace do
		local ok, isModel = pcall(function() return node:IsA("Model") end)
		if ok and isModel then top = node end
		node = node.Parent
	end
	return top
end

local function freshHrpPos()
	local _, _, root = freshChar()
	return root and root.Position
end

local function freshFirstPart(obj)
	if not obj then return nil end
	local ok, isPart = pcall(function() return obj:IsA("BasePart") end)
	if ok and isPart then return obj end
	local found = nil
	pcall(function() found = obj:FindFirstChildWhichIsA("BasePart", true) end)
	return found
end

local function freshZero(model)
	pcall(function()
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				p.AssemblyLinearVelocity = Vector3.zero
				p.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end)
end

-- teleport helper: car PivotTo when seated, HRP CFrame on foot
local function freshGoto(cf)
	local seat = freshSeat()
	if seat then
		local car = freshCar(seat)
		if car then
			local ok = pcall(function()
				freshZero(car)
				car:PivotTo(cf)
			end)
			if ok then return true end
		end
	end
	local _, _, root = freshChar()
	if root then
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = cf
		end)
		return true
	end
	return false
end

-- remote resolver: find any RemoteEvent/RemoteFunction by (name, class), cached
local FreshRemotes = nil
local function freshRemoteMap()
	if FreshRemotes then return FreshRemotes end
	FreshRemotes = {}
	pcall(function()
		for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
			pcall(function()
				if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
					FreshRemotes[d.ClassName .. "\0" .. d.Name] = d
				end
			end)
		end
	end)
	return FreshRemotes
end
local function freshRemote(name, class)
	class = class or "RemoteEvent"
	local hit = freshRemoteMap()[class .. "\0" .. name]
	if hit then return hit end
	FreshRemotes = nil
	return freshRemoteMap()[class .. "\0" .. name]
end

