-- ===== Sky-road autofarm (client-sided, 1000 studs up) =====
-- Classic dealership farm: a long private road in the sky. Drive it, and when
-- you reach the edge you are put back at the start. Client-sided parts do not
-- replicate (FilteringEnabled), so other players do not see this road.
local SKY = { LEN = 2200, WIDTH = 26, Y_OFF = 1000, EDGE = 80 }
local function destroySkyRoad()
	pcall(function()
		local old = workspace:FindFirstChild("VenasSkyRoad")
		if old then old:Destroy() end
	end)
	Flags.SkyStart, Flags.SkyEnd, Flags.SkyLaps = nil, nil, nil
end
local function buildSkyRoad()
	destroySkyRoad()
	local _, _, root = parts()
	local origin = ((root and root.Position) or Vector3.new(0, 50, 0)) + Vector3.new(0, SKY.Y_OFF, 0)
	local s = origin
	local e = origin + Vector3.new(SKY.LEN, 0, 0)
	local folder = Instance.new("Folder")
	folder.Name = "VenasSkyRoad"
	pcall(function() folder.Parent = workspace end)
	local function mkPart(name, size, cf, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Anchored = true
		p.CanCollide = true
		if color then p.Color = color end
		p.Material = Enum.Material.SmoothPlastic
		p.Parent = folder
		return p
	end
	local mid = (s + e) / 2
	-- road top surface height; everything else is built flush to it
	local topY = mid.Y + 1
	mkPart("Road", Vector3.new(SKY.LEN, 2, SKY.WIDTH), CFrame.new(mid), Color3.fromRGB(30, 30, 35))
	-- low guard rails so you do not slide off sideways (cover the start pad too)
	local railMid = mid + Vector3.new(6, 0, 0)
	mkPart("RailL", Vector3.new(SKY.LEN + 18, 6, 1), CFrame.new(railMid + Vector3.new(0, 4, SKY.WIDTH / 2)), Color3.fromRGB(200, 60, 60))
	mkPart("RailR", Vector3.new(SKY.LEN + 18, 6, 1), CFrame.new(railMid + Vector3.new(0, 4, -SKY.WIDTH / 2)), Color3.fromRGB(200, 60, 60))
	-- giant green platform 1000x1000 under the start of the road.
	-- top sits 0.1 below the road top: visually the same level, no lip to
	-- catch on, and no coplanar faces so nothing flickers.
	local slabC = Vector3.new(s.X + 400, (topY - 0.1) - 2, s.Z)
	mkPart("StartPad", Vector3.new(1000, 4, 1000), CFrame.new(slabC), Color3.fromRGB(60, 200, 120))
	-- tall perimeter rails around the slab so fast cars stay on it
	local px, pz, py = slabC.X, slabC.Z, topY + 5
	mkPart("SlabN", Vector3.new(1000, 10, 1), CFrame.new(Vector3.new(px, py, pz - 500)), Color3.fromRGB(200, 60, 60))
	mkPart("SlabS", Vector3.new(1000, 10, 1), CFrame.new(Vector3.new(px, py, pz + 500)), Color3.fromRGB(200, 60, 60))
	mkPart("SlabW", Vector3.new(1, 10, 1000), CFrame.new(Vector3.new(px - 500, py, pz)), Color3.fromRGB(200, 60, 60))
	-- east wall split in two so the road (26 wide) exits the slab through a gap
	mkPart("SlabE1", Vector3.new(1, 10, 487), CFrame.new(Vector3.new(px + 500, py, pz - 256.5)), Color3.fromRGB(200, 60, 60))
	mkPart("SlabE2", Vector3.new(1, 10, 487), CFrame.new(Vector3.new(px + 500, py, pz + 256.5)), Color3.fromRGB(200, 60, 60))
	Flags.SkyStart, Flags.SkyEnd, Flags.SkyLaps = s, e, 0
	return s, e
end
local function skyStartCF()
	local s = Flags.SkyStart
	if not s then return nil end
	-- spawn exactly 1 stud above the road top (road top = s.Y + 1), a bit
	-- forward (+15 X) so the whole car sits on the road clear of the rail
	-- start edge / pad seam instead of straddling it and catching.
	local p = s + Vector3.new(15, 2, 0)
	return CFrame.lookAt(p, p + Vector3.new(1, 0, 0))
end

